         "-nostartfiles", "-nolibc",
         "-L/home/pdietl/.local/share/alire/toolchains/gnat_arm_elf_15.2.1_a5e9cfb1/arm-eabi/lib/gnat/light-cortex-m4//ld_user") &
         Compiler.Common_Required_Switches;

      case Loader is
